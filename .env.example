# AI Provider API Keys (configure one or more)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here
LLAMA_API_KEY=your-llama-key-here
XAI_API_KEY=your-xai-key-here
PERPLEXITY_API_KEY=your-perplexity-key-here
OLLAMA_BASE_URL=http://localhost:11434

# AI model (optional — defaults to claude-sonnet-4-20250514).
# The id must be one of the catalog entries below; anything else is rejected.
#   Anthropic:  claude-sonnet-4-5-20250929, claude-sonnet-4-20250514,
#               claude-opus-4-1-20250805, claude-opus-4-20250514,
#               claude-haiku-4-5-20251001
#   OpenAI:     gpt-5.5, gpt-5.4, gpt-5.4-mini
#               (gpt-5.3-codex and gpt-5.3-codex-spark only in Codex CLI mode)
#   Google:     gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash
#   Mistral:    mistral-large-latest, mistral-medium-latest, mistral-small-latest
#   Meta:       Llama-4-Maverick-17B-128E-Instruct-FP8,
#               Llama-4-Scout-17B-16E-Instruct, Llama-3.3-70B-Instruct
#   xAI:        grok-3, grok-3-fast, grok-3-mini, grok-3-mini-fast
#   Perplexity: sonar-pro, sonar, sonar-reasoning-pro, sonar-reasoning
#   Ollama:     any model installed locally, prefixed with "ollama:"
#               (e.g. ollama:llama3.2) — models reported by the running
#               Ollama instance are also accepted without the prefix.
AI_MODEL=claude-sonnet-4-20250514

# Image generation provider: openai, gemini, or codex
IMAGE_PROVIDER=openai
