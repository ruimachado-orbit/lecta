{
  "name": "lecta",
  "version": "0.1.2",
  "packageManager": "bun@1.3.11",
  "description": "Open-source technical presentation platform with executable code blocks",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "lint": "eslint . --max-warnings=1000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp": "cd packages/mcp-server && npm test",
    "test:all": "vitest run && cd packages/mcp-server && npm test",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
